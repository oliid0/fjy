{
  "compilerOptions": {
    "target": "ESNext",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "allowSyntheticDefaultImports": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "emitDeclarationOnly": true,
    "paths": {
      "@fcboard/common": ["./common/src/index.ts"],
      "@fcboard/common/*": ["./common/src/*"],
      "@fcboard/element": ["./element/src/index.ts"],
      "@fcboard/element/*": ["./element/src/*"],
      "@fcboard/fcboard": ["./fcboard/index.tsx"],
      "@fcboard/fcboard/*": ["./fcboard/*"],
      "@fcboard/math": ["./math/src/index.ts"],
      "@fcboard/math/*": ["./math/src/*"],
      "@fcboard/utils": ["./utils/src/index.ts"],
      "@fcboard/utils/*": ["./utils/src/*"]
    }
  }
}
