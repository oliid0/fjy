        "^(?:please)?start(?:the)?(?:timer|countdown)(?:for(\\d+|one|two|three|four|five|six|seven|eight|nine|ten|eleven|twelve)(minutes?|mins?|seconds?|secs?))?$"
      ],
      "compact": true,
