{
  "private": true,
  "name": "fcboard-monorepo",
  "workspaces": [
    "app",
    "packages/*",
    "examples/*"
  ],
  "devDependencies": {
    "@babel/preset-env": "7.26.9",
    "@excalidraw/eslint-config": "1.0.3",
    "@excalidraw/prettier-config": "1.0.2",
    "@playwright/test": "1.56.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.2.0",
    "@types/chai": "4.3.0",
    "@types/jest": "27.4.0",
    "@types/lodash.throttle": "4.1.7",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@types/socket.io-client": "3.0.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "3.1.0",
    "@vitest/coverage-v8": "3.0.7",
    "@vitest/ui": "2.0.5",
    "chai": "4.3.6",
    "dotenv": "16.0.1",
    "eslint-config-prettier": "8.5.0",
    "eslint-config-react-app": "7.0.1",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-prettier": "3.3.1",
    "fake-indexeddb": "3.1.7",
    "http-server": "14.1.1",
    "husky": "7.0.4",
    "jsdom": "22.1.0",
    "lint-staged": "12.3.7",
    "pepjs": "0.5.3",
    "prettier": "2.6.2",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "rewire": "6.0.0",
    "rimraf": "^5.0.0",
    "typescript": "5.9.3",
    "vite": "5.0.12",
    "vite-plugin-checker": "0.7.2",
    "vite-plugin-ejs": "1.7.0",
    "vite-plugin-pwa": "0.21.1",
    "vite-plugin-svgr": "4.2.0",
    "vitest": "3.0.6",
    "vitest-canvas-mock": "0.3.3",
    "ws": "8.22.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "homepage": ".",
  "prettier": "@excalidraw/prettier-config",
  "scripts": {
    "build-node": "node ./scripts/build-node.js",
    "build:app:docker": "npm run build:app:docker --prefix ./app",
    "build:app": "npm run build:app --prefix ./app",
    "build:common": "npm run build:esm --prefix ./packages/common",
    "build:element": "npm run build:esm --prefix ./packages/element",
    "build:excalidraw": "npm run build:esm --prefix ./packages/fcboard",
    "build:math": "npm run build:esm --prefix ./packages/math",
    "build:packages": "npm run build:common && npm run build:math && npm run build:element && npm run build:excalidraw",
    "build:version": "npm run build:version --prefix ./app",
    "build": "npm run build --prefix ./app",
    "build:preview": "npm run build:preview --prefix ./app",
    "start": "npm run start --prefix ./app",
    "start:production": "npm run start:production --prefix ./app",
    "start:example": "npm run build:packages && npm run start --prefix ./examples/with-script-in-browser",
    "test:all": "pnpm check && pnpm lint && pnpm test:other && pnpm test",
    "test:app": "vitest",
    "test:code": "eslint --max-warnings=0 --ext .js,.ts,.tsx .",
    "test:other": "prettier \"**/*.{css,scss,json,md,html,yml,yaml}\" --ignore-path=.prettierignore --check",
    "test:typecheck": "tsc",
    "test:update": "npm run test:app -- --update --watch=false",
    "test": "vitest run",
    "test:coverage": "vitest --coverage",
    "test:coverage:watch": "vitest --coverage --watch",
    "test:ui": "npm run test -- --ui --coverage.enabled=true",
    "fix:code": "npm run test:code -- --fix",
    "fix:other": "npm run prettier -- --write",
    "fix": "npm run fix:other && npm run fix:code",
    "locales-coverage": "node scripts/build-locales-coverage.js",
    "locales-coverage:description": "node scripts/locales-coverage-description.js",
    "prepare": "husky install",
    "prettier": "prettier \"**/*.{css,scss,json,md,html,yml}\" --ignore-path=.prettierignore",
    "release": "node scripts/release.js",
    "release:test": "node scripts/release.js --tag=test",
    "release:next": "node scripts/release.js --tag=next",
    "release:latest": "node scripts/release.js --tag=latest",
    "rm:build": "rimraf --glob app/build app/dist app/dev-dist packages/*/dist packages/*/build examples/*/build examples/*/dist",
    "rm:node_modules": "rimraf --glob node_modules app/node_modules packages/*/node_modules",
    "clean-install": "npm run rm:node_modules && npm install",
    "check": "tsc --noEmit",
    "lint": "eslint --max-warnings=0 --ext .js,.ts,.tsx ."
  },
  "resolutions": {
    "strip-ansi": "6.0.1"
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "7.0.1",
    "@capacitor/android": "8.2.0",
    "@capacitor/cli": "8.2.0",
    "@capacitor/core": "8.2.0"
  },
  "pnpm": {
    "overrides": {
      "strip-ansi": "6.0.1",
      "@types/react": "19.0.10",
      "@types/react-dom": "19.0.4"
    }
  },
  "eslintConfig": {
    "extends": [
      "@excalidraw/eslint-config",
      "react-app"
    ],
    "rules": {
      "import/order": [
        "warn",
        {
          "groups": [
            "builtin",
            "external",
            "internal",
            "parent",
            "sibling",
            "index",
            "object",
            "type"
          ],
          "pathGroups": [
            {
              "pattern": "@excalidraw/**",
              "group": "external",
              "position": "after"
            }
          ],
          "newlines-between": "always-and-inside-groups",
          "warnOnUnassignedImports": true
        }
      ],
      "import/no-anonymous-default-export": "off",
      "no-restricted-globals": "off",
      "@typescript-eslint/consistent-type-imports": [
        "error",
        {
          "prefer": "type-imports",
          "disallowTypeAnnotations": false,
          "fixStyle": "separate-type-imports"
        }
      ],
      "no-restricted-imports": [
        "error",
        {
          "name": "jotai",
          "message": "Do not import from \"jotai\" directly. Use our app-specific modules (\"editor-jotai\" or \"app-jotai\")."
        }
      ],
      "react/jsx-no-target-blank": [
        "error",
        {
          "allowReferrer": true
        }
      ]
    },
    "overrides": [
      {
        "files": [
          "packages/fcboard/**/*.{ts,tsx}"
        ],
        "excludedFiles": [
          "packages/fcboard/**/*.test.{ts,tsx}",
          "packages/fcboard/**/*.test.*.{ts,tsx}"
        ],
        "rules": {
          "@typescript-eslint/no-restricted-imports": [
            "error",
            {
              "patterns": [
                {
                  "group": [
                    "@excalidraw/excalidraw"
                  ],
                  "message": "Do not import from the barrel 'index.tsx' files. Use direct relative imports to the specific module instead.",
                  "allowTypeImports": true
                }
              ],
              "paths": [
                ".",
                "..",
                "../..",
                "../../..",
                "../../../..",
                "../../../../..",
                "../index",
                "../../index",
                "../../../index",
                "../../../../index"
              ]
            }
          ]
        }
      }
    ]
  },
  "eslintIgnore": [
    "node_modules/",
    "build/",
    "package-lock.json",
    ".vscode/",
    "firebase/",
    "dist/",
    "public/workbox",
    "packages/fcboard/types",
    "examples/**/public",
    "dev-dist",
    "coverage",
    "pnpm-lock.yaml",
    "ss/",
    "android/vendor/libadb/src/",
    "public/ocr/"
  ]
}
